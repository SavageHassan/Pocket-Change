# --- M0 (current milestone) ---
# No secrets required. M0 only reads public market data (Raydium public API,
# MEXC public REST API) — no wallet or exchange API keys involved.

# Optional tuning (defaults shown):
RAYDIUM_POLL_MS=4000
MEXC_POLL_MS=2000
MIN_NET_SPREAD_BPS=5
MAX_QUOTE_AGE_MS=15000
MEXC_TAKER_FEE_BPS=10
ANOMALY_THRESHOLD_BPS=500
LOG_LEVEL=info

# --- Needed starting M1 (paper trading) ---
# None yet — M1 simulates fills against the same public data feeds above.

# --- Needed starting M3 (testnet/sandbox execution) ---
# SOLANA_DEVNET_RPC_URL=
# SOLANA_WALLET_PRIVATE_KEY=        # devnet-only keypair, never mainnet
# MEXC_API_KEY=                     # sandbox/testnet key if MEXC offers one; trading-only scope, withdrawals disabled (FR-10.3)
# MEXC_API_SECRET=

# --- Never put mainnet keys or real capital credentials in this file. ---
