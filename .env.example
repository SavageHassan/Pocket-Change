# --- M0/M1/M2 ---
# No secrets required. All three read/simulate against public market data
# (Raydium public API, MEXC + Bybit public REST) — no wallet or exchange API
# keys involved.

# Optional tuning (defaults shown):
RAYDIUM_POLL_MS=4000
MEXC_POLL_MS=2000
BYBIT_POLL_MS=2000
MIN_NET_SPREAD_BPS=5
MAX_QUOTE_AGE_MS=15000
MEXC_TAKER_FEE_BPS=10
BYBIT_TAKER_FEE_BPS=10
ANOMALY_THRESHOLD_BPS=500
PAPER_TRADE_SIZE_USD=500
LOG_LEVEL=info

# --- M3 (devnet/testnet execution) ---

# Solana devnet RPC. The default public endpoint works but its airdrop
# faucet is frequently rate-limited/dry — if `npm run setup:devnet-pool`
# can't get funded, fund the wallet yourself (address printed by the
# script) via `solana airdrop 1 <address> --url devnet` or
# https://faucet.solana.com, then re-run the script.
SOLANA_DEVNET_RPC_URL=https://api.devnet.solana.com

# Auto-generated the first time you run any execution script (e.g.
# `npm run setup:devnet-pool`) and appended below this line automatically —
# you don't need to set this yourself. Devnet-only, holds no real value.
# SOLANA_WALLET_PRIVATE_KEY=

# Bybit Demo Trading (api-demo.bybit.com) — a real order-submission sandbox
# with no real funds, NOT a mainnet key. To get one: log into bybit.com,
# switch to "Demo Trading" from the account menu (creates a separate demo
# account if you don't have one), then generate an API key from there.
# BYBIT_API_KEY=
# BYBIT_API_SECRET=

# MEXC has no sandbox/testnet at all (confirmed against their current docs
# while building this) — there is no key to put here. MEXC stays in
# detect/paper mode only until that changes or a mainnet decision is made.

# --- Never put mainnet keys or real capital credentials in this file. ---
